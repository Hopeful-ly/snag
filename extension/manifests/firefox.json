{
  "manifest_version": 2,
  "name": "Snag Download Manager",
  "description": "Download videos and files with Snag: a button on videos, quality choices, fast multi-connection downloads. Talks only to the Snag program on this computer.",
  "version": "0.11.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "snag@snagdl.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "storage",
    "menus",
    "downloads",
    "cookies",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Snag",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
